# PowerShell 5.1 reads BOM-less UTF-8 as ANSI (garbling non-ASCII).
#   .ps1 must keep UTF-8 BOM + CRLF - pin the line endings so git won't change them.
*.ps1 text eol=crlf

# Binary - not subject to diff / line-ending conversion
*.png   binary
*.ico   binary
*.woff2 binary
*.woff  binary
*.ttf   binary
*.exe   binary
