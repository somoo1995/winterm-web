# -- Logs (session names / path history end up here; never commit) --
*.log

# -- Build artifacts --
build/
dist/
__pycache__/
*.pyc
webterm.exe

# -- Work-in-progress backups --
_backup/

# -- Experimental xterm.js versions (only static/vendor/ is actually used) --
static/vendor-*/

# -- User settings (defaults live in config.default.json; user values aren't committed) --
config.json

# -- Docs and screenshots are not published --
# A screenshot once carried internal client info (IPs, domains, security structure) (2026-09-11).
# Dev notes and the textbook aren't needed to run it and aren't fully reviewed, so they're untracked.
# They stay locally - to publish, review each image/line and un-ignore explicitly.
docs/

# Dev test page (not needed to run it)
static/scrolltest.html
